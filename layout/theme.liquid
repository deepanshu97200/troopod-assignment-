98 1397 309 Q1555 295 1712 300 Q1869 309 2026 301 Q2184 321 2341 311" stroke="url(#cg)" stroke-width="5.5" fill="none" opacity="0.47" stroke-linecap="round"/></g></svg></div>
        <div class="wl wl-b"><svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="cg2" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#eafff4" stop-opacity="0"/><stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/><stop offset=".5" stop-color="#ffffff" stop-opacity="1"/><stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/><stop offset="1" stop-color="#eafff4" stop-opacity="0"/></linearGradient></defs><g><path d="M355 217 Q442 234 529 234 Q616 202 703 222 Q790 190 877 203 Q964 215 1051 202 Q1138 242 1225 221 Q1312 235 1399 234 Q1486 202 1573 223" stroke="url(#cg2)" stroke-width="3.4" fill="none" opacity="0.17" stroke-linecap="round"/><path d="M160 723 Q278 720 396 713 Q514 738 633 725 Q751 735 869 734 Q987 715 1105 728 Q1223 706 1341 715 Q1459 720 1577 713" stroke="url(#cg2)" stroke-width="1.1" fill="none" opacity="0.17" stroke-linecap="round"/></g></svg></div>
        <div class="wl wl-c"><svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/><stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/><stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/></linearGradient></defs><g><polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#sg)" opacity="0.26"/><polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#sg)" opacity="0.41"/><polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#sg)" opacity="0.31"/></g></svg></div>
        <div class="wl wl-s"><svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="sf" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity=".55"/><stop offset=".55" stop-color="#e8fff2" stop-opacity=".16"/><stop offset="1" stop-color="#e8fff2" stop-opacity="0"/></linearGradient></defs><g><rect x="-100" y="-40" width="2000" height="150" fill="url(#sf)"/><rect x="-100" y="60" width="2000" height="60" fill="url(#sf)" opacity=".5"/></g></svg></div>
