<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: 'Build your bundle' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'One box. Every room.' }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subheading | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' }}</p>
      </div>
    </div>

    <div class="tiers">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign delay_class = '' %}
          {% if forloop.index == 2 %}{% assign delay_class = 'rv-d2' %}{% elsif forloop.index == 3 %}{% assign delay_class = 'rv-d3' %}{% endif %}

          <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv {{ delay_class }}" {{ block.shopify_attributes }}>
            <span class="tag">{{ block.settings.tag | default: 'Bundle Tier' }}</span>
            
            <div class="tierpix {% if block.settings.qty == '5' or block.settings.qty == 5 %}five{% endif %}" aria-hidden="true">
              {% if block.settings.qty == '2' or block.settings.qty == 2 %}
                <span class="pimg p-combo2" role="img" aria-label="Combo 2"></span>
              {% elsif block.settings.qty == '5' or block.settings.qty == 5 %}
                <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
                <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
                <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
                <span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span>
                <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
              {% else %}
                <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
                <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
                <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
              {% endif %}
            </div>

            <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
            <div class="price">{{ block.settings.price }} {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}</div>
            <p class="body-s" style="font-size:12px">{{ block.settings.per_item_text }}</p>

            <ul>
              {% assign bullets = block.settings.bullets | split: newline %}
              {% for bullet in bullets %}
                {% if bullet != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                    {{ bullet }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>

            <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.link | default: '#shop' }}">
              {{ block.settings.button_text | default: 'Build this box' }}
              {% if block.settings.is_best %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {% endif %}
            </a>
          </article>
        {% endfor %}
      {% else %}
        <!-- Default Spec Tiers -->
        <article class="glass tier rv">
          <span class="tag">Starter</span>
          <div class="tierpix" aria-hidden="true"><span class="pimg p-combo2" role="img" aria-label="Tap cleaner and kitchen cleaner combo pack"></span></div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹174 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any two products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>

        <article class="glass tier best rv rv-d2">
          <span class="tag">Most popular</span>
          <div class="tierpix" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span><span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span></div>
          <div class="qty">3<small>Products</small></div>
          <div class="price">₹499 <s>₹897</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹166 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any three products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Covers kitchen and laundry</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-primary" href="#shop">Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </article>

        <article class="glass tier rv rv-d3">
          <span class="tag">Whole home</span>
          <div class="tierpix five" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span><span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span><span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span><span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span></div>
          <div class="qty">5<small>Products</small></div>
          <div class="price">₹799 <s>₹1495</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹160 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any five products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Every room in one order</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "bundle_tier",
      "name": "Bundle Tier Card",
      "settings": [
        { "type": "checkbox", "id": "is_best", "label": "Highlight as Most Popular", "default": false },
        { "type": "text", "id": "tag", "label": "Tag Label", "default": "Starter" },
        { "type": "text", "id": "qty", "label": "Product Quantity Number", "default": "3" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare Price", "default": "₹897" },
        { "type": "text", "id": "per_item_text", "label": "Per Item Cost Text", "default": "Flat ₹166 per product" },
        { "type": "textarea", "id": "bullets", "label": "Bullets (One per line)", "default": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Build this box" },
        { "type": "url", "id": "link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Bundles" }]
}
{% endschema %}