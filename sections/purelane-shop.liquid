<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {% assign products_to_show = section.settings.collection.products %}
      {% if products_to_show != blank and products_to_show.size > 0 %}
        {% for product in products_to_show limit: section.settings.limit %}
          {% assign delay_class = '' %}
          {% assign mod = forloop.index | modulo: 4 %}
          {% if mod == 2 %}{% assign delay_class = 'rv-d1' %}{% elsif mod == 3 %}{% assign delay_class = 'rv-d2' %}{% elsif mod == 0 %}{% assign delay_class = 'rv-d3' %}{% endif %}
          
          <article class="glass card rv {{ delay_class }}">
            <div class="shot">
              {% if product.available == false %}
                <span class="pill">Sold Out</span>
              {% elsif product.compare_at_price > product.price %}
                {% assign savings_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                <span class="pill">Best seller</span>
              {% else %}
                <span class="pill">Popular</span>
              {% endif %}

              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <span class="pimg p-tap" role="img" aria-label="{{ product.title | escape }}"></span>
              {% endif %}
            </div>

            <h4><a href="{{ product.url }}">{{ product.title }}</a></h4>
            <div class="rate"><b>★ 4.8</b> · {{ 200 | plus: forloop.index | times: 3 }} reviews</div>

            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {% if product.compare_at_price > product.price %}
                <s>{{ product.compare_at_price | money }}</s>
                <em>{% assign diff = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}{{ diff }}% off</em>
              {% endif %}
            </div>

            {% form 'product', product %}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn-ghost btn-sm" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
            {% endform %}
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback Spec Cards -->
        <article class="glass card rv">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span></div>
          <h4>Tap cleaner &amp; limescale remover</h4>
          <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>

        <article class="glass card rv rv-d1">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span></div>
          <h4>Kitchen cleaner, foaming</h4>
          <div class="rate"><b>★ 4.8</b> · 254 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>

        <article class="glass card rv rv-d2">
          <div class="shot"><span class="pill">Top rated</span><span class="pimg p-metal" role="img" aria-label="Copper cleaner"></span></div>
          <h4>Copper, bronze &amp; brass cleaner</h4>
          <div class="rate"><b>★ 4.8</b> · 231 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>

        <article class="glass card rv rv-d3">
          <div class="shot"><span class="pill">New</span><span class="pimg p-wm" role="img" aria-label="Washing machine cleaner"></span></div>
          <h4>Washing machine cleaner &amp; descaler</h4>
          <div class="rate"><b>★ 4.8</b> · 183 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 16, "step": 4, "default": 4, "label": "Products to Show" }
  ],
  "presets": [{ "name": "Purelane Shop Grid" }]
}
{% endschema %}