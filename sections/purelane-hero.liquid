<section class="hero" data-scene="1" id="top">
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        </span>
        <span>{{ section.settings.badge1 | default: 'Plant<br>powered' }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <span>{{ section.settings.badge2 | default: 'Safe for<br>kids &amp; pets' }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
        </span>
        <span>{{ section.settings.badge3 | default: 'Zero harsh<br>chemicals' }}</span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          Clean<br>That<br><span class="lime">Lasts</span>
        {% endif %}
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.' }}</p>
      
      <div class="hero-cta rv rv-d3">
        {% if section.settings.cta1_text != blank %}
          <a class="btn btn-primary" href="{{ section.settings.cta1_link | default: '#shop' }}">
            {{ section.settings.cta1_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {% endif %}
        {% if section.settings.cta2_text != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.cta2_link | default: '#how' }}">{{ section.settings.cta2_text }}</a>
        {% endif %}
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          Zero harsh chem
        </div>
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="hslide hs{{ forloop.index }} {% if forloop.first %}on{% endif %}" data-n="{{ forloop.index }}" {{ block.shopify_attributes }}>
              {% if block.settings.img1 != blank %}
                {{ block.settings.img1 | image_url: width: 600 | image_tag: class: 'hp a d1', loading: 'eager', alt: block.settings.title }}
              {% else %}
                <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
              {% endif %}
              
              {% if forloop.index >= 2 %}
                {% if block.settings.img2 != blank %}
                  {{ block.settings.img2 | image_url: width: 600 | image_tag: class: 'hp b d2', loading: 'eager', alt: block.settings.title }}
                {% else %}
                  <span class="hp p-tbtl b d2" role="img" aria-label="Purelane tap cleaner spray bottle"></span>
                {% endif %}
              {% endif %}

              {% if forloop.index >= 3 %}
                {% if block.settings.img3 != blank %}
                  {{ block.settings.img3 | image_url: width: 600 | image_tag: class: 'hp c d3', loading: 'eager', alt: block.settings.title }}
                {% else %}
                  <span class="hp p-mbtl c d3" role="img" aria-label="Purelane copper cleaner pump bottle"></span>
                {% endif %}
              {% endif %}

              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label | default: 'Bundle Option' }}</span>
                <span class="val">
                  <strong>{{ block.settings.price | default: '₹200' }}</strong>
                  {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}
                </span>
                {% if block.settings.cut_text != blank %}
                  <span class="cut">{{ block.settings.cut_text }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Default Slides matching Spec -->
          <div class="hslide hs1 on" data-n="1">
            <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag">
              <span class="lbl">Single bottle</span>
              <span class="val"><strong>₹200</strong><s>₹299</s></span>
              <span class="cut">33% off</span>
            </div>
          </div>
          <div class="hslide hs2" data-n="2">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag">
              <span class="lbl">Any 2 products</span>
              <span class="val"><strong>₹349</strong><s>₹598</s></span>
              <span class="cut">Save ₹249</span>
            </div>
          </div>
          <div class="hslide hs3" data-n="3">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
            <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag">
              <span class="lbl">Any 3 products</span>
              <span class="val"><strong>₹499</strong><s>₹897</s></span>
              <span class="cut">Save ₹398</span>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="hdots" id="hdots">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <button type="button" class="{% if forloop.first %}on{% endif %}" aria-label="Show {{ forloop.index }} product"></button>
          {% endfor %}
        {% else %}
          <button type="button" class="on" aria-label="Show 1 product"></button>
          <button type="button" class="" aria-label="Show 2 products"></button>
          <button type="button" class="" aria-label="Show 3 products"></button>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading HTML", "default": "Clean<br>That<br><span class=\"lime\">Lasts</span>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA Label", "default": "Shop now" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA Link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA Label", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA Link" },
    { "type": "html", "id": "badge1", "label": "Badge 1 HTML", "default": "Plant<br>powered" },
    { "type": "html", "id": "badge2", "label": "Badge 2 HTML", "default": "Safe for<br>kids &amp; pets" },
    { "type": "html", "id": "badge3", "label": "Badge 3 HTML", "default": "Zero harsh<br>chemicals" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product Stage Slide",
      "settings": [
        { "type": "text", "id": "label", "label": "Stage Label", "default": "Single bottle" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹200" },
        { "type": "text", "id": "compare_price", "label": "Compare Price", "default": "₹299" },
        { "type": "text", "id": "cut_text", "label": "Discount Cut Tag", "default": "33% off" },
        { "type": "image_picker", "id": "img1", "label": "Product Image 1" },
        { "type": "image_picker", "id": "img2", "label": "Product Image 2" },
        { "type": "image_picker", "id": "img3", "label": "Product Image 3" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Hero" }]
}
{% endschema %}