<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: 'That&#39;s what they said' }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>{{ section.settings.rating | default: '4.8' }}</b> {{ section.settings.rating_count | default: 'from 8,000+ reviews' }}</span>
      <span class="agg">{{ section.settings.social_proof | default: 'Loved by <b>12 lakh+</b> homes' }}</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% if section.blocks.size > 0 %}
        {% for i in (1..2) %}
          {% for block in section.blocks %}
            <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}>
              <div class="st">
                {% assign star_num = block.settings.stars | default: 5 %}
                {% for star in (1..star_num) %}&#9733;{% endfor %}
              </div>
              <h5 {% if i == 2 %}tabindex="-1"{% endif %}>{{ block.settings.title }}</h5>
              <p>{{ block.settings.body }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.author }}</b>
                {% if block.settings.product_name != blank %}
                  <span>&middot; {{ block.settings.product_name }}</span>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        {% endfor %}
      {% else %}
        <!-- Default Spec Reviews Track (Duplicated for Seamless Infinite Loop) -->
        {% for i in (1..2) %}
          <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5 {% if i == 2 %}tabindex="-1"{% endif %}>Works like a charm</h5>
            <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Anita</b><span>&middot; Laundry detergent</span></div>
          </article>
          <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5 {% if i == 2 %}tabindex="-1"{% endif %}>Best dishwash ever</h5>
            <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Priya</b><span>&middot; Dishwash gel</span></div>
          </article>
          <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5 {% if i == 2 %}tabindex="-1"{% endif %}>Great product, great packaging</h5>
            <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Sunita</b><span>&middot; Liquid handwash</span></div>
          </article>
          <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5 {% if i == 2 %}tabindex="-1"{% endif %}>Dog friendly</h5>
            <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Rohit S.</b><span>&middot; Floor cleaner</span></div>
          </article>
          <article class="glass-2 rcard" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5 {% if i == 2 %}tabindex="-1"{% endif %}>Sparkling taps again</h5>
            <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Verified buyer</b><span>&middot; Tap cleaner</span></div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Aggregate Rating", "default": "4.8" },
    { "type": "text", "id": "rating_count", "label": "Review Count Label", "default": "from 8,000+ reviews" },
    { "type": "html", "id": "social_proof", "label": "Social Proof HTML", "default": "Loved by <b>12 lakh+</b> homes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Star Rating" },
        { "type": "text", "id": "title", "label": "Review Headline", "default": "Works like a charm" },
        { "type": "textarea", "id": "body", "label": "Review Body", "default": "Finally an eco option that cleans as well as chemical detergents." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Anita" },
        { "type": "text", "id": "product_name", "label": "Product Purchased", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Reviews Rail" }]
}
{% endschema %}