<!-- ================= SIGNUP ================= -->
<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Join the Purelane Club' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Get ₹100 off your first bundle' }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.subheading | default: 'Plus first access to new launches and restocks.' }}</p>
      
      {% form 'customer', class: 'signup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex;gap:9px;max-width:430px;margin:22px auto 0;flex-wrap:wrap;width:100%;">
          <input type="email" name="contact[email]" placeholder="your@email.com" aria-label="Email address" required>
          <button class="btn btn-primary" type="submit">Get my ₹100 off</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Signup",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Plus first access to new launches and restocks." }
  ],
  "presets": [{ "name": "Purelane Signup" }]
}
{% endschema %}
